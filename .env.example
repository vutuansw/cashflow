APP_NAME="WePo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Hai database trên cùng MySQL, xem plan/01.
# cashflow_groups: dữ liệu khách hàng. cashflow_system: quản trị HIPOTECH.
DB_CONNECTION=groups
DB_HOST=127.0.0.1
DB_PORT=3306
DB_GROUPS_DATABASE=cashflow_groups
DB_SYSTEM_DATABASE=cashflow_system
DB_USERNAME=cashflow
DB_PASSWORD=

# Khóa HMAC để tra cứu SĐT đã mã hóa. Khác APP_KEY. Tạo bằng: php artisan cashflow:key
# Mất APP_KEY là mất SĐT/địa chỉ, mất PHONE_HASH_KEY là không đăng nhập bằng SĐT được:
# sao lưu cả hai ra ngoài server.
PHONE_HASH_KEY=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Gửi email qua Gmail weposupport@gmail.com, xem plan/07 mục 4b.
# MAIL_PASSWORD là "mật khẩu ứng dụng" 16 ký tự Google cấp (không phải mật khẩu Gmail).
# Máy dev để MAIL_MAILER=log cho thư chỉ ghi vào storage/logs, server thật đổi thành smtp.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=weposupport@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="weposupport@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Đọc bill chuyển khoản qua OpenRouter, xem plan/04 và config/ai.php.
# AI_DRIVER=fake khi chưa có khóa. Để trống model thì dùng mặc định trong config/ai.php.
AI_DRIVER=fake
OPENROUTER_API_KEY=
AI_VISION_MODEL=
AI_VISION_FALLBACK_MODEL=
AI_USD_VND=26000

VITE_APP_NAME="${APP_NAME}"
